def gmail_connect(address, password):
    """Log in to Gmail and return the connected server.
    Tries port 465 (SSL) first, then port 587 (STARTTLS), because many
    networks and antivirus programs block one of them.
    Raises smtplib.SMTPAuthenticationError if the password is wrong, or
    ConnectionError if Gmail cannot be reached either way."""
    ctx = ssl.create_default_context()
    problems = []

    try:
        server = smtplib.SMTP_SSL("smtp.gmail.com", 465, context=ctx, timeout=20)
        server.login(address, password)
        return server
    except smtplib.SMTPAuthenticationError:
        raise
    except (OSError, smtplib.SMTPException) as err:
        problems.append(f"port 465: {err}")

    try:
        server = smtplib.SMTP("smtp.gmail.com", 587, timeout=20)
        server.ehlo()
        server.starttls(context=ctx)
        server.ehlo()
        server.login(address, password)
        return server
    except smtplib.SMTPAuthenticationError:
        raise
    except (OSError, smtplib.SMTPException) as err:
        problems.append(f"port 587: {err}")

    raise ConnectionError("Gmail could not be reached (" + "; ".join(problems) + ")")

