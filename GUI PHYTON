        self.heading(f"LESSON {i + 1}: {lesson['title'].upper()}")
        box = scrolledtext.ScrolledText(self.container, font=MONO, wrap="word",
                                        bg=CARD, relief="flat", padx=12, pady=10)
        box.insert("1.0", lesson["notes"])
        box.configure(state="disabled")
        box.pack(fill="both", expand=True)
        row = tk.Frame(self.container, bg=BG)
        row.pack(fill="x", pady=10)
        self.button(row, "Take the quiz", self.start_quiz, accent=True, side="left")
        self.button(row, "Back to the menu", self.show_menu, side="right")

    # ---------------- quiz ----------------
    def start_quiz(self):
        self.q_i = 0
        self.score = 0
        self.show_question()

    def show_question(self):
        self.clear()
        lesson = LESSONS[self.lesson_i]
        qs = lesson["questions"]
        prompt, options, correct, hint = qs[self.q_i]

        self.heading(f"LESSON {self.lesson_i + 1} QUIZ  -  Question "
                     f"{self.q_i + 1} of {len(qs)}")
        card = tk.Frame(self.container, bg=CARD, highlightthickness=1,
                        highlightbackground="#d8dde8")
        card.pack(fill="x", pady=6)
        tk.Label(card, text=prompt, font=FONT_B, bg=CARD, justify="left",
                 wraplength=700, anchor="w").pack(fill="x", padx=16, pady=(14, 8))

        self.answer_var.set("")
        self.entry = None
        self.radios = []
        if options:
            for k, opt in enumerate(options, start=1):
                rb = tk.Radiobutton(card, text=f"{k}) {opt}", variable=self.answer_var,
                                    value=str(k), font=FONT, bg=CARD, anchor="w",
                                    activebackground=CARD)
                rb.pack(fill="x", padx=30, pady=2)
                self.radios.append(rb)
            tk.Frame(card, bg=CARD, height=10).pack()
        else:
            self.entry = ttk.Entry(card, font=FONT, textvariable=self.answer_var)
            self.entry.pack(fill="x", padx=16, pady=(0, 16))
            self.entry.focus()
            self.entry.bind("<Return>", lambda e: self.check_answer())

        self.feedback = tk.Label(self.container, text="", font=FONT_B, bg=BG,
                                 wraplength=700, justify="left")
        self.feedback.pack(anchor="w", pady=8)

        row = tk.Frame(self.container, bg=BG)
        row.pack(fill="x", pady=6)
        self.submit_btn = ttk.Button(row, text="Submit answer",
                                     command=self.check_answer, style="Accent.TButton")
        self.submit_btn.pack(side="left")
        self.next_btn = ttk.Button(row, text="Next", command=self.next_question)
        tk.Label(row, text=f"Score: {self.score}", font=FONT, bg=BG).pack(side="right")

    def check_answer(self):
        if self.submit_btn["state"] == "disabled":
            return
        raw = self.answer_var.get()
        if not raw.strip():
            self.feedback.config(text="Please choose or type an answer first.", fg=RED)
            return
        _, options, correct, hint = LESSONS[self.lesson_i]["questions"][self.q_i]
        if options:
            ok = raw == correct
        else:
            cleaned = raw.strip().lower().replace(" ", "")
            ok = cleaned in [c.lower().replace(" ", "") for c in correct]
        if ok:
            self.score += 1
            self.feedback.config(text="Correct!", fg=GREEN)
        else:
            self.feedback.config(text=f"Wrong. Hint: {hint}", fg=RED)

        self.submit_btn.config(state="disabled")
        for rb in self.radios:
            rb.config(state="disabled")
        if self.entry is not None:
            self.entry.config(state="disabled")
        last = self.q_i == len(LESSONS[self.lesson_i]["questions"]) - 1
        self.next_btn.config(text="See my score" if last else "Next")
        self.next_btn.pack(side="left", padx=8)
        self.next_btn.focus()

    def next_question(self):
        self.q_i += 1
        if self.q_i >= len(LESSONS[self.lesson_i]["questions"]):
            self.show_result()
        else:
            self.show_question()

    def show_result(self):
        self.clear()
        total_q = len(LESSONS[self.lesson_i]["questions"])
        perfect = self.score == total_q
        self.heading(f"LESSON {self.lesson_i + 1} RESULT", GREEN if perfect else RED)
        tk.Label(self.container, text=f"Score: {self.score} out of {total_q}",
                 font=("Segoe UI", 16), bg=BG).pack(pady=10)
        if perfect:
            self.passed.add(self.lesson_i)
            self.save_progress()
            tk.Label(self.container,
                     text=f"PERFECT! Lesson {self.lesson_i + 1} passed. Badge earned!",
                     font=FONT_B, fg=GREEN, bg=BG).pack(pady=6)
            if len(self.passed) == TOTAL:
                tk.Label(self.container,
                         text="You passed ALL lessons - your certificate is unlocked!",
                         font=FONT_B, fg=GOLD, bg=BG).pack(pady=6)
                self.auto_send_label = tk.Label(self.container, text="", font=FONT_B,
                                                bg=BG, wraplength=700, justify="center")
                self.auto_send_label.pack(pady=6)
                if self.logged_in and not self.cert_sent:
                    self.auto_send_label.config(
                        text=f"Sending your certificate to {self.email} ...", fg="#555")
                    self.update_idletasks()
                    ok, why = self.send_certificate_email(
                        self.email, self.email, self.app_password)
                    if ok:
                        self.cert_sent = True
                        self.save_progress()
                        self.auto_send_label.config(
                            text=f"Certificate sent to {self.email}! "
                                 "Check your inbox (and Spam).", fg=GREEN)
                    else:
                        self.auto_send_label.config(
                            text=f"{why}\nYou can try again from 'Get my certificate'.",
                            fg=RED)
                elif self.logged_in and self.cert_sent:
                    self.auto_send_label.config(
                        text=f"Your certificate was already sent to {self.email}.",
                        fg=GREEN)
                else:
                    self.auto_send_label.config(
                        text="Open 'Get my certificate' to send it by email.", fg="#555")
            self.button(self.container, "Back to the menu", self.show_menu,
                        accent=True, pady=14)
        else:
            tk.Label(self.container, text="Not perfect yet. What do you want to do?",
                     font=FONT, bg=BG).pack(pady=6)
            self.button(self.container, "Retake the quiz", self.start_quiz,
                        accent=True, pady=4)
            self.button(self.container, "Review the lesson again",
                        lambda: self.show_lesson(self.lesson_i), pady=4)
            self.button(self.container, "Back to the menu", self.show_menu, pady=4)

    # ---------------- certificate ----------------
    def show_certificate(self):
        self.clear()
        if len(self.passed) < TOTAL:
            left = TOTAL - len(self.passed)
            self.heading("CERTIFICATE LOCKED", RED)
            tk.Label(self.container,
                     text=f"Not yet! Pass {left} more lesson(s) to unlock your certificate.",
                     font=FONT, bg=BG).pack(pady=20)
            self.button(self.container, "Back to the menu", self.show_menu, accent=True)
            return

        cert = tk.Frame(self.container, bg="#fffdf4", highlightthickness=4,
                        highlightbackground=GOLD)
        cert.pack(fill="x", pady=(0, 10), ipady=6)
        tk.Label(cert, text="CERTIFICATE OF COMPLETION", font=("Georgia", 20, "bold"),
                 fg=GOLD, bg="#fffdf4").pack(pady=(14, 4))
        tk.Label(cert, text=self.player, font=("Georgia", 24, "bold italic"),
                 bg="#fffdf4").pack(pady=4)
        tk.Label(cert, text=f"passed all {TOTAL} lessons of the\nACT102 Python Quest and is now a",
                 font=("Georgia", 12), bg="#fffdf4").pack()
        tk.Label(cert, text="*** PYTHON MASTER ***", font=("Georgia", 16, "bold"),
                 fg=ACCENT, bg="#fffdf4").pack(pady=(4, 12))

        self.status = tk.Label(self.container, text="", font=FONT_B, bg=BG,
                               wraplength=700, justify="left")

        if self.logged_in:
            # Logged in: the certificate goes to the Gmail used for login
            if self.cert_sent:
                msg = f"Your certificate was sent to {self.email}."
                color = GREEN
            else:
                msg = f"Your certificate has not been sent yet to {self.email}."
                color = "#555"
            tk.Label(self.container, text=msg, font=FONT_B, fg=color,
                     bg=BG, wraplength=700, justify="left").pack(anchor="w", pady=(6, 2))
            self.status.pack(anchor="w", pady=4)
            row = tk.Frame(self.container, bg=BG)
            row.pack(fill="x", pady=6)
            self.send_btn = ttk.Button(
                row, text="Send again" if self.cert_sent else "Send to my Gmail",
                style="Accent.TButton", command=self.send_logged_in)
            self.send_btn.pack(side="left")
            self.button(row, "Back to the menu", self.show_menu, side="right")
            return

        # Not logged in (played without email): ask for the Gmail details now
        tk.Label(self.container, text="Send my certificate to Gmail",
                 font=FONT_B, bg=BG).pack(anchor="w", pady=(6, 2))
        form = tk.Frame(self.container, bg=BG)
        form.pack(fill="x")
        form.columnconfigure(1, weight=1)

        def field(r, label, show=None):
            tk.Label(form, text=label, font=FONT, bg=BG).grid(
                row=r, column=0, sticky="w", pady=3, padx=(0, 10))
            e = ttk.Entry(form, font=FONT, show=show)
            e.grid(row=r, column=1, sticky="ew", pady=3)
            return e

        self.gmail_entry = field(0, "Your Gmail:")
        self.pw2_entry = field(1, "Gmail App Password:", show="*")
        tk.Label(self.container,
                 text="Use a 16-character Google App Password (Google Account > Security >\n"
                      "2-Step Verification > App passwords). It is used once and never saved.",
                 font=("Segoe UI", 9), fg="#555", bg=BG, justify="left").pack(
            anchor="w", pady=4)
        self.status.pack(anchor="w", pady=4)
        row = tk.Frame(self.container, bg=BG)
        row.pack(fill="x", pady=6)
        self.send_btn = ttk.Button(row, text="Send certificate", style="Accent.TButton",
                                   command=self.send_manual)
        self.send_btn.pack(side="left")
        self.button(row, "Back to the menu", self.show_menu, side="right")

    def send_logged_in(self):
        self.send_btn.config(state="disabled")
        self.status.config(text="Sending...", fg="#555")
        self.update_idletasks()
        ok, why = self.send_certificate_email(self.email, self.email, self.app_password)
        if ok:
            self.cert_sent = True
            self.save_progress()
            self.status.config(text=f"Sent! Check the inbox of {self.email} "
                                    "(and the Spam folder).", fg=GREEN)
        else:
            self.status.config(text=why, fg=RED)
        self.send_btn.config(state="normal")

    def send_manual(self):
        addr = self.gmail_entry.get().strip().lower()
        password = self.pw2_entry.get().replace(" ", "")
        if "@" not in addr or len(password) != 16:
            self.status.config(text="Enter your Gmail and the 16-letter Google App "
                                    "Password (not your normal password).", fg=RED)
            return
        self.send_btn.config(state="disabled")
        self.status.config(text="Sending...", fg="#555")
        self.update_idletasks()
        ok, why = self.send_certificate_email(addr, addr, password)
        if ok:
            self.status.config(text=f"Sent! Check the inbox of {addr} "
                                    "(and the Spam folder).", fg=GREEN)
        else:
            self.status.config(text=why, fg=RED)
        self.send_btn.config(state="normal")


if __name__ == "__main__":
    PythonQuest().mainloop()
