def get_rank(passed):
    if passed == TOTAL:
        return "Python Master"
    if passed >= 4:
        return "Coder"
    if passed >= 1:
        return "Apprentice"
    return "Newbie"


class PythonQuest(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("Python Quest - ACT102")
        self.geometry("820x640")
        self.minsize(720, 560)
        self.configure(bg=BG)

        self.player = ""
        self.email = ""              # the Gmail the user logged in with
        self.app_password = ""       # kept in memory only, never saved
        self.logged_in = False       # True once Gmail login was verified
        self.cert_sent = False       # True once the certificate was emailed
        self.passed = set()          # indexes of passed lessons
        self.lesson_i = 0
        self.q_i = 0
        self.score = 0
        self.answer_var = tk.StringVar()

        style = ttk.Style(self)
        try:
            style.theme_use("clam")
        except tk.TclError:
            pass
        style.configure("TButton", font=FONT, padding=8)
        style.configure("Accent.TButton", font=FONT_B, padding=8,
                        background=ACCENT, foreground="white")
        style.map("Accent.TButton", background=[("active", "#2f5bb3")])

        self.container = tk.Frame(self, bg=BG)
        self.container.pack(fill="both", expand=True, padx=20, pady=16)
        self.show_welcome()

    # ---------------- helpers ----------------
    def clear(self):
        for w in self.container.winfo_children():
            w.destroy()

    def heading(self, text, color=ACCENT):
        tk.Label(self.container, text=text, font=FONT_H, fg=color,
                 bg=BG).pack(anchor="w", pady=(0, 10))

    def button(self, parent, text, command, accent=False, **pack):
        b = ttk.Button(parent, text=text, command=command,
                       style="Accent.TButton" if accent else "TButton")
        b.pack(**pack)
        return b

    # ---------------- saving progress ----------------
    def load_all(self):
        try:
            with open(SAVE_FILE, "r", encoding="utf-8") as f:
                return json.load(f)
        except (OSError, ValueError):
            return {}

    def save_progress(self):
        if not self.email:
            return
        data = self.load_all()
        data[self.email] = {"name": self.player,
                            "passed": sorted(self.passed),
                            "cert_sent": self.cert_sent}
        try:
            with open(SAVE_FILE, "w", encoding="utf-8") as f:
                json.dump(data, f, indent=2)
        except OSError:
            pass   # saving is a bonus; the game still works without it

    def load_progress(self):
        saved = self.load_all().get(self.email)
        if saved:
            self.passed = {i for i in saved.get("passed", []) if 0 <= i < TOTAL}
            self.cert_sent = bool(saved.get("cert_sent", False))
            if not self.player:
                self.player = saved.get("name", "")
            return True
        return False

    # ---------------- login ----------------
    def show_welcome(self):
        self.clear()
        tk.Label(self.container, text="PYTHON QUEST", font=("Segoe UI", 30, "bold"),
                 fg=ACCENT, bg=BG).pack(pady=(24, 4))
        tk.Label(self.container, text="Learn Python. Pass quizzes. Win badges.",
                 font=FONT, bg=BG).pack()
        tk.Label(self.container, text="Log in with your Gmail",
                 font=("Segoe UI", 14, "bold"), bg=BG).pack(pady=(24, 8))

        form = tk.Frame(self.container, bg=BG)
        form.pack()
        form.columnconfigure(1, weight=1)

        def field(r, label, show=None):
            tk.Label(form, text=label, font=FONT, bg=BG).grid(
                row=r, column=0, sticky="w", pady=4, padx=(0, 10))
            e = ttk.Entry(form, font=FONT, width=34, show=show)
            e.grid(row=r, column=1, sticky="ew", pady=4)
            e.bind("<Return>", lambda ev: self.login())
            return e

        self.name_entry = field(0, "Your name:")
        self.email_entry = field(1, "Gmail address:")
        self.pw_entry = field(2, "Gmail App Password:", show="*")
        self.name_entry.focus()

        tk.Label(self.container,
                 text="Your certificate will be emailed to this Gmail automatically\n"
                      "when you pass all 7 lessons. Use a 16-character Google App Password\n"
                      "(Google Account > Security > 2-Step Verification > App passwords),\n"
                      "not your normal password. It is never saved.",
                 font=("Segoe UI", 9), fg="#555", bg=BG, justify="center").pack(pady=8)

        self.login_status = tk.Label(self.container, text="", font=FONT_B, bg=BG,
                                     wraplength=640, justify="center")
        self.login_status.pack(pady=4)
        self.login_btn = ttk.Button(self.container, text="Log in", style="Accent.TButton",
                                    command=self.login)
        self.login_btn.pack(pady=6)
        ttk.Button(self.container, text="Play without email",
                   command=self.play_offline).pack()

    def login(self):
        name = self.name_entry.get().strip()
        email = self.email_entry.get().strip().lower()
        password = self.pw_entry.get().replace(" ", "")
        if not name:
            self.login_status.config(text="Please type your name.", fg=RED)
            return
        if not (email.endswith("@gmail.com") or email.endswith("@googlemail.com")) \
                or " " in email or email.count("@") != 1:
            self.login_status.config(text="Please enter a valid Gmail address "
                                          "(like name@gmail.com).", fg=RED)
            return
        if len(password) != 16:
            self.login_status.config(
                text=f"That password has {len(password)} characters. A Google App Password "
                     "is exactly 16 letters (not your normal Gmail password).", fg=RED)
            return

        # Check the Gmail login really works before letting the user in
        self.login_btn.config(state="disabled")
        self.login_status.config(text="Checking your Gmail login...", fg="#555")
        self.update_idletasks()
        try:
            gmail_connect(email, password).quit()
        except smtplib.SMTPAuthenticationError:
            self.login_status.config(
                text="Login failed. Use a Google App Password "
                     "(2-Step Verification must be on), not your normal password.", fg=RED)
            self.login_btn.config(state="normal")
            return
        except Exception as err:
            self.login_status.config(
                text=f"Could not reach Gmail: {err}\nCheck your internet, or use "
                     "'Play without email'.", fg=RED)
            self.login_btn.config(state="normal")
            return

        self.player = name
        self.email = email
        self.app_password = password
        self.logged_in = True
        self.passed = set()
        self.cert_sent = False
        returning = self.load_progress()
        self.player = name           # keep the name typed this time
        self.save_progress()
        if returning:
            messagebox.showinfo("Welcome back",
                                f"Welcome back, {name}!\nYou have passed "
                                f"{len(self.passed)} of {TOTAL} lessons.")
        self.show_menu()

    def play_offline(self):
        name = self.name_entry.get().strip()
        if not name:
            self.login_status.config(text="Please type your name first.", fg=RED)
            return
        self.player = name
        self.email = ""
        self.app_password = ""
        self.logged_in = False
        self.passed = set()
        self.cert_sent = False
        self.show_menu()

    def logout(self):
        self.player = ""
        self.email = ""
        self.app_password = ""
        self.logged_in = False
        self.passed = set()
        self.cert_sent = False
        self.show_welcome()

    # ---------------- sending the certificate ----------------
    def send_certificate_email(self, to_addr, from_addr, password):
        """Returns (True, "") if sent, or (False, "reason")."""
        today = date.today().strftime("%B %d, %Y")
        text = (f"CERTIFICATE OF COMPLETION\n\n{self.player}\n"
                f"passed all {TOTAL} lessons of the ACT102 Python Quest\n"
                f"and is now a PYTHON MASTER.\n\nDate: {today}\n")
        html = f"""
        <div style="font-family:Georgia,serif;max-width:560px;margin:auto;padding:30px;
                    border:6px double #c9962b;text-align:center;background:#fffdf4">
          <h1 style="color:#c9962b;margin-top:0">CERTIFICATE OF COMPLETION</h1>
          <p>This certifies that</p>
          <h2 style="font-size:30px;margin:8px 0"><i>{self.player}</i></h2>
          <p>passed all {TOTAL} lessons of the<br><b>ACT102 Python Quest</b><br>and is now a</p>
          <h2 style="color:#3b6fd4">&#9733; PYTHON MASTER &#9733;</h2>
          <p style="color:#777">{today}</p>
        </div>"""
        msg = EmailMessage()
        msg["Subject"] = "Your Python Quest Certificate"
        msg["From"] = from_addr
        msg["To"] = to_addr
        msg.set_content(text)
        msg.add_alternative(html, subtype="html")
        try:
            server = gmail_connect(from_addr, password)
            try:
                server.send_message(msg)
            finally:
                try:
                    server.quit()
                except smtplib.SMTPException:
                    pass
            return True, ""
        except smtplib.SMTPAuthenticationError:
            return False, ("Login failed. Use a Google App Password "
                           "(2-Step Verification must be on).")
        except Exception as err:
            return False, f"Could not send: {err}"

