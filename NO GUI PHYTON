import smtplib                          # tool for sending email
from email.message import EmailMessage  # tool for writing an email


# A function is a small block of code with a name. We can use it many times.
# This one logs in to Gmail. It returns the connection if it worked,
# or the word "wrong" if the password was wrong, or "offline" if no internet.
def gmail_login(address, password):
    try:
        server = smtplib.SMTP_SSL("smtp.gmail.com", 465, timeout=20)
        server.login(address, password)
        return server
    except smtplib.SMTPAuthenticationError:
        return "wrong"
    except Exception:
        pass   # port 465 did not work, so try the other way below
    try:
        server = smtplib.SMTP("smtp.gmail.com", 587, timeout=20)
        server.starttls()
        server.login(address, password)
        return server
    except smtplib.SMTPAuthenticationError:
        return "wrong"
    except Exception:
        return "offline"


# This function sends the certificate email. It returns True if it worked.
def send_certificate(address, password, name):
    server = gmail_login(address, password)
    if server == "wrong":
        print("Login failed. Check your App Password.")
        return False
    if server == "offline":
        print("Could not reach Gmail. Check your internet.")
        return False
    mail = EmailMessage()
    mail["Subject"] = "Your Python Quest Certificate"
    mail["From"] = address
    mail["To"] = address
    mail.set_content(
        "CERTIFICATE OF COMPLETION\n\n"
        + name + "\n"
        "passed all 7 lessons of the ACT102 Python Quest\n"
        "and is now a PYTHON MASTER.\n")
    server.send_message(mail)
    server.quit()
    return True


